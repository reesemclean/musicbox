# Git
.git
.gitignore

# Node modules (will be installed in container)
**/node_modules

# Build outputs (will be rebuilt in container)
packages/web/.output
packages/web/.vinxi

# Runtime media library. Lives in a Docker volume, never in the image — but
# without this it still lands in the build context, so a build machine that has
# actually run the app ships its whole library to the daemon, and adding a
# single song invalidates the layer cache for the entire web build.
# Note this does not match seed-data/, which is a different directory and is
# genuinely needed in the image.
packages/web/data

# Development files
**/.env
**/.env.local
**/musicbox.db
**/musicbox.db-journal

# ESP32 build artifacts (source needed for firmware-builder)
packages/esp32/.pio
packages/esp32/.vscode

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation
docs
*.md
!packages/web/seed-data/**

# Test files
**/*.test.ts
**/*.spec.ts
**/vitest.config.ts
