# ============================================================================
# MusicBox Firmware Builder
# One-shot container: compiles ESP32 firmware, writes to /firmware/, then exits.
#
# Uses Python + pip-installed PlatformIO on a glibc-based image so the
# ESP32 toolchain binaries can execute properly.
#
# Env vars (provided via docker-compose):
#   WIFI_SSID, WIFI_PASS, MQTT_BROKER_HOST, MQTT_BROKER_PORT,
#   API_BASE_URL, FIRMWARE_VERSION
# ============================================================================

FROM python:3.12

RUN pip install --no-cache-dir platformio

WORKDIR /build

# Copy ESP32 project
COPY packages/esp32/ packages/esp32/

# Install platform, toolchain, and libraries by doing a dummy build.
# The build will fail (no env vars for build_flags.sh) but all packages
# get downloaded. We ignore the failure.
RUN cd packages/esp32 && \
    WIFI_SSID=dummy WIFI_PASS=dummy pio run 2>&1 || true && \
    ls -la /root/.platformio/packages/

COPY scripts/docker-build-firmware.sh /docker-build-firmware.sh
RUN chmod +x /docker-build-firmware.sh

ENTRYPOINT ["/docker-build-firmware.sh"]
