[Unit]
Description=MusicBox Player
After=network.target sound.target
Wants=sound.target

[Service]
Type=simple
User=musicbox
Group=musicbox
WorkingDirectory=/opt/musicbox/player
ExecStart=/usr/bin/node /opt/musicbox/player/dist/player.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=SERVER_URL={{ server_url }}
Environment=DEVICE_SECRET={{ device_secret }}

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/musicbox
PrivateTmp=true

[Install]
WantedBy=multi-user.target
