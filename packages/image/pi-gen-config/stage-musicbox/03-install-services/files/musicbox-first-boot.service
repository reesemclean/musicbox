[Unit]
Description=MusicBox First Boot Setup
After=local-fs.target
Before=network-online.target
ConditionPathExists=!/opt/musicbox/.first-boot-complete

[Service]
Type=oneshot
ExecStart=/opt/musicbox/musicbox-first-boot.sh
ExecStartPost=/usr/bin/touch /opt/musicbox/.first-boot-complete
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
