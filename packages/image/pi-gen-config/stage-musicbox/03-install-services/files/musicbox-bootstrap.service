[Unit]
Description=MusicBox Bootstrap
Documentation=https://github.com/anthropics/musicbox
After=network-online.target musicbox-first-boot.service
Wants=network-online.target
Requires=musicbox-first-boot.service
ConditionPathExists=!/opt/musicbox/.bootstrap-complete

[Service]
Type=oneshot
ExecStart=/opt/musicbox/musicbox-bootstrap.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
