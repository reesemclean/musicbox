{
  "name": "player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-transform-types src/index.ts",
    "dev:nowatch": "node --experimental-transform-types src/index.ts",
    "build": "tsc",
    "build:bundle": "node --experimental-transform-types bundle.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "shared": "file:../shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0"
  }
}
