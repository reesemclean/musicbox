{
  "name": "musicbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/server",
    "packages/player",
    "packages/shared",
    "packages/image",
    "packages/agent"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:player": "npm run dev --workspace=player",
    "build": "npm run build --workspaces --if-present",
    "build:image": "npm run build --workspace=packages/image",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=packages/server",
    "db:migrate": "npm run db:migrate --workspace=packages/server",
    "db:push": "npm run db:push --workspace=packages/server",
    "db:studio": "npm run db:studio --workspace=packages/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
